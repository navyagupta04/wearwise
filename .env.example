PORT=8787
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wearwise
YOUCAM_API_KEY=replace_me
YOUCAM_API_BASE_URL=https://api.youcamapps.com
# Apparel VTO uses /s2s/v2.0/file/cloth-v3 and /s2s/v2.0/task/cloth-v3 under this base URL.
SHOPPING_SEARCH_API_KEY=replace_me
LLM_API_KEY=replace_me
# Optional explicit Gemini naming; LLM_API_KEY is also accepted.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.6-flash
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=wearwise-uploads
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=replace_me
OBJECT_STORAGE_SECRET_KEY=replace_me
